# One brand, or many? Leave EMPTY for the multi-brand shell (an agency running several projects:
# brand switcher, brands grid, per-brand members and invites). Set it to a brand's UUID and the app
# serves that brand only — the switcher, the brands list and the invite screens stop existing, and
# /app goes straight there.
#
# The UUID and nothing else: the name and the slug live on the `brands` row, and a copy of them
# here would be a second source of truth that drifts silently the day someone renames the brand.
# `npm run db:seed` prints the line to paste. If this points at a row that does not exist the app
# says so and stops — it never invents a brand.
TENANT_BRAND_ID=

# Public (safe to expose) — your Supabase project (hosted or self-hosted). Anon/publishable key
# only: it is meant to be public, but still point it at YOUR project, never ours.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Public app origin (no trailing slash) — used to build absolute one-tap approve links from
# the autopilot cron, which has no request to read url.origin from. Use the live www host so
# sitemap/canonicals match production (apex and legacy domains 308 here). e.g. https://www.anomalia.so
PUBLIC_APP_URL=

# The origin the Node server believes it is serving — adapter-node only (`npm run start`, the
# compose image). Leave it unset and adapter-node infers the origin from request headers and
# assumes **https**: the CSRF check then compares the browser's `http://…` Origin against it and
# rejects every form POST, sign-in included. Same value as PUBLIC_APP_URL, no trailing slash.
# The cost of setting it: brand blogs served on their own domains need a reverse proxy in front
# of the app (see docs/SELF_HOSTING.md). On Vercel this is unused — the adapter knows its origin.
# Commented out on purpose: adapter-node tells an EMPTY value apart from a missing one and refuses
# to boot on `ORIGIN=` ("Invalid ORIGIN: ''"). Uncomment it with a value, or leave the line alone.
# ORIGIN=http://localhost:3000

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Public key is safe to expose; private key is server-only. Without both, push is a soft no-op.
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URI for the push service (mailto: or https:)
VAPID_SUBJECT=mailto:hello@domain.com

# Server-only secrets — fill locally, never commit
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for `npm run db:migrate` / `db:seed` only (the app talks through Supabase).
# For the bundled compose stack, after filling POSTGRES_PASSWORD in infra/compose/.env:
# DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/postgres
RESEND_API_KEY=
# Transactional email sender. The domain must be verified in Resend (anomalia.so is).
# Defaults to "Anomalia <noreply@anomalia.so>" if unset.
EMAIL_FROM=

# Brand analysis (Google Gemini) — optional Google pixel fallback + blog-month image batch only.
# Text, embeddings, video/audio QC and music go through LLM_* below. Images/video/TTS stay on Kie.
GEMINI_API_KEY=
# Flash text/vision model (review, last-mile, chat vision, onboarding). Read at request time —
# change this on Vercel without a rebuild. Must be gemini-<n>-flash (not an image model).
# GEMINI_FLASH=gemini-3.7-flash

# ── LLM gateway (OpenAI-compatible). Production: OpenRouter. ────────────────────────────────
# One client for text, structured JSON, embeddings, video/audio reviewers, Lyria music.
# Not a second Google SDK. Photo / video generation / TTS stay on Kie.
# REQUIRED: senza LLM_API_KEY chat, embeddings e giudici si fermano con errori nominati
# (llm_unconfigured, llm_video_unconfigured, llm_embedding_unconfigured).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-2.5-flash
# Comma-separated picker list. Fast/auto = first id, Pro = second if present.
# Gli id devono esistere sul gateway puntato da LLM_BASE_URL.
LLM_MODELS=google/gemini-2.5-flash,google/gemini-2.5-pro
# QC video/audio (not clip generation). Empty → LLM_DEFAULT_MODEL only if it is google/gemini-*.
# LLM_VIDEO_REVIEWER_MODEL=google/gemini-2.5-flash
# Embeddings. Never falls back to the chat model. Must match vector(768).
EMBEDDING_MODEL=google/gemini-embedding-001
# AGENT_KIT è sperimentale e SPENTO di default (accendilo con AGENT_KIT=on). La chat, col kit
# o senza, parla solo col centralino LLM_*; KIE_API_KEY serve a immagini, clip, voce e probe GEO.
# CHAT_ACTION_JUDGE=off          # auto-review consequential kit actions before execution
# Quanto ragionano i giudici Gemini (video review, QC immagini, caption panel, prepublish, motion):
# low | medium | high. Default high. Dalla 3.x Gemini prende un LIVELLO, non un tetto di token —
# GEMINI_JUDGE_THINKING_BUDGET e PREPUBLISH_THINKING_BUDGET non arrivano più all'API.
# I thinking token si pagano al prezzo dell'output: se la spesa dei giudici sale, è questa la leva.
# GEMINI_JUDGE_THINKING_LEVEL=high
# Solo il prepublish check (prima girava senza thinking, che 3.7 Flash non sa fare).
# PREPUBLISH_THINKING_LEVEL=high

# Google PageSpeed Insights API key (free tool /tools/page-speed).
# Quota: 25k requests/day — the tool-guard cap keeps us well under it.
PAGESPEED_API_KEY=

# Browserless (cloud headless browser) — OPTIONAL. Used during brand analysis to render
# JS-heavy sites (Framer/Webflow/Next) so client-rendered nav links + content are reachable,
# and to harvest real images. If unset, analysis gracefully falls back to static fetch only.
BROWSERLESS_API_KEY=
# Optional region override (default: https://production-sfo.browserless.io).
BROWSERLESS_BASE_URL=

# kie.ai — videos, IMAGES, VOICE-OVER, and the GEO citation probes. No chat: all text goes
# through LLM_* (above).
# Optional for video: if missing, video generation falls back to a rendered cover image.
# Images (Nano Banana 2 Lite by default, via kie) and the voice-over TTS route through kie
# whenever this key is set:
#   IMAGE_PROVIDER=gemini  puts every render back on Google's API without a deploy
#   TTS_PROVIDER=gemini    does the same for the voice-over (the music bed is ALWAYS Google/Lyria)
#   KIE_IMAGE_RESOLUTION   1K (default) | 2K | 4K — case-sensitive, "2k" is a 500 from kie.
#                          Applies to pro/2 only; nano-banana-2-lite is 1K-only.
KIE_API_KEY=
# Optional video model overrides (defaults: grok-imagine-video-1-5-preview / grok-imagine/text-to-video).
# Brands can also pick a model in Settings → Video (content_prefs.videoModel). Duration ceilings
# follow the chosen model's caps — never set a global MAX_DURATION here.
# KIE_VIDEO_MODEL_I2V=bytedance/seedance-2-5
# KIE_VIDEO_MODEL_T2V=bytedance/seedance-2-5
# KIE_VIDEO_MODEL_UPSCALE=grok-imagine/upscale
# KIE_VIDEO_RESOLUTION=480p
# Legacy singular override (ignored by the renderer — use I2V/T2V above):
# KIE_VIDEO_MODEL=
# Optional Luna model id override — GEO citation audit only (default: gpt-5-6-luna).
# KIE_LUNA_MODEL=

# Error tracking (Sentry) — optional, off by default (client and server both no-op without it).
# Create your own Sentry project and paste its DSN; never reuse Anomalia's, or your errors report
# to our project. Only takes effect in production builds (NODE_ENV=production).
PUBLIC_SENTRY_DSN=

# Analytics (added later)
# PostHog public client key (phc_…). Project is on EU cloud (api_host eu.i.posthog.com).
PUBLIC_POSTHOG_KEY=
PUBLIC_CLARITY_ID=
# Seline project token (Settings → General). Used by the client script and by
# @seline-analytics/node for server-side setUser / track. No default: without this, Seline never
# loads and no user is identified. Set it in production or analytics go quiet.
PUBLIC_SELINE_TOKEN=
# Meta Pixel id — browser pixel AND the server Conversions API (which also needs META_CAPI_TOKEN).
# No default either: unset means no pixel is injected and no conversion is sent.
PUBLIC_META_PIXEL_ID=

# Zernio (same account as dalnulla; Anomalia isolates via per-brand profiles)
ZERNIO_API_KEY=

# scrapecreators (pulls each connected profile's full organic post history — Studio > Knowledge sync)
SCRAPECREATORS_API_KEY=
# Ceiling per singola richiesta, ms. Default 60000. Node fetch non ha timeout: senza questo
# un socket bloccato appende l'intero run (misurate risposte da 43 minuti).
SCRAPECREATORS_TIMEOUT_MS=

# Stripe (Anomalia account; live). Runtime needs the secret key. Price ids are in src/lib/server/stripe.ts.
STRIPE_SECRET_KEY=
# Coupon id for the retention offer in the cancel-plan dialog: 50% off, duration repeating,
# 2 months. If unset, the offer button surfaces a config error.
STRIPE_RETENTION_COUPON=

# Signing secret for one-tap email approve links (set a long random string)
APP_SECRET=

# Recurring autopilot tick (/api/v1/autopilot/tick). Two ways to authorise:
#  • Vercel Cron (production): set CRON_SECRET in the Vercel project — Vercel auto-injects
#    "Authorization: Bearer $CRON_SECRET" into the scheduled GET (see vercel.json `crons`).
#  • Manual/external scheduler: send X-Autopilot-Secret: $AUTOPILOT_SECRET (GET or POST).
# Either matching secret is accepted. Set long random strings; NEVER expose to the client.
CRON_SECRET=
AUTOPILOT_SECRET=


# Agent loops — DEFAULT ON. Set any to false to fall back to the legacy one-shot path
# (fail-open: a failing agent still degrades to legacy without a deploy).
# Same opt-out pattern as SEO_AGENT_ENABLED / ANALYTICS_REVIEW_AGENT_ENABLED.
STRATEGY_AGENT_ENABLED=
WEEK_PLANNER_AGENT_ENABLED=
# Produce agent + multimodal reviewer (Grok 4.5 via kie): research → justified captions/images
# → review → retry same session up to 4×. PRODUCE_AGENT_ENABLED=false → legacy executePlan.
PRODUCE_AGENT_ENABLED=
IMAGE_AGENT_ENABLED=
# ── AI_ROUTE_* — image / video / TTS only. Text is LLM_* (above). ───────────────────────────
# Sintassi: FAMIGLIA@ENDPOINT. Foto, clip e voce restano su Kie; il testo no.
# AI_ROUTE_IMAGE=nano-banana@kie  render immagini.            Sostituisce IMAGE_PROVIDER
# AI_ROUTE_TTS=gemini-tts@kie     voice-over.                 Sostituisce TTS_PROVIDER
# AI_ROUTE_VIDEO_I2V=…            id modello kie.             Sostituisce KIE_VIDEO_MODEL_I2V
# AI_ROUTE_VIDEO_T2V=…                                        Sostituisce KIE_VIDEO_MODEL_T2V
# AI_ROUTE_VIDEO_UPSCALE=…                                    Sostituisce KIE_VIDEO_MODEL_UPSCALE
#
# ── Le vecchie variabili, ancora lette per image/TTS/video (AI_ROUTE_* vince quando c'è) ────
# LLM provider leftovers (ignored for background text — use LLM_*):
GTM_PROVIDER=
# kie.ai text model when a leftover caller still forces kie (default: grok-4-5). Requires KIE_API_KEY.
KIE_MODEL=
# Transport leftover for Gemini Flash: google | kie. Background text uses LLM_* instead.
GEMINI_TRANSPORT=
# GEO citation probes — cheapest kie models (defaults shown; override only if needed).
# KIE_CITATION_GPT=gpt-5-6-luna
# KIE_CITATION_GROK=grok-4-3
# KIE_CITATION_CLAUDE=claude-haiku-4-5
# DeepSeek official API (default model: deepseek-v4-flash).
# Docs: https://api-docs.deepseek.com — OpenAI-compatible base URL.
# Two uses, and background structured work is no longer one of them (that went back to Gemini
# Flash — a dead key here used to make every background call do a doomed attempt, wait for the
# 402 and redo the work on Gemini, invisibly). What is left: the web-search grounding provider
# (deepseek-search.ts, second after Exa, and a tracked GEO answer engine).
# A 401/402 on this key disables DeepSeek for the running process; a top-up applies on the next
# cold start.
DEEPSEEK_API_KEY=
# Optional override (default https://api.deepseek.com).
DEEPSEEK_BASE_URL=
# Optional model id override (default deepseek-v4-flash) — used by the web-search grounding.
DEEPSEEK_MODEL=
# Optional model override for the DeepSeek Pro custom chat option (default deepseek-v4-pro).
DEEPSEEK_PRO_MODEL=
# Optional kie Codex overrides for GPT 5.6 custom chat models (defaults gpt-5-6-terra / gpt-5-6-sol).
# KIE_TERRA_MODEL=gpt-5-6-terra
# KIE_SOL_MODEL=gpt-5-6-sol
# Default chat tier when the client omits it: auto | fast | pro | deepseek-pro | gpt-terra | gpt-sol.
CHAT_TIER=fast
# Design Studio (Remotion composition + browser still render). Default off.
FEATURE_DESIGN_STUDIO=
# Go plan (€25 prepare-and-export, no Zernio). Default off — set true on Vercel to sell it.
FEATURE_PLAN_GO=
# Soft→hard GSC gate on SEO plan generation when OAuth is configured. Default on; set false to disable.
FEATURE_GSC_GATE=
# Inject GSC into the default SEO agent + keyword strategy. Default on.
FEATURE_GSC_IN_AGENT=
# GEO apply publishes a live URL (article or /p/… landing). Default on; set false for draft-only.
FEATURE_GEO_PUBLISH_APPLY=
# GEO win requires target/brand host in cited sources (causal). Default on; set false for legacy any-mention.
FEATURE_GEO_CAUSAL_WIN=
# Sidebar "La squadra": 5 sezioni (Spazi/Strumenti) al posto dei macro-hub. Default off.
FEATURE_NAV_TEAM=
# Chat di gruppo: più agenti nello stesso thread, uno smistatore decide chi risponde. Default off
# (serve anche la migration 0209; senza, ogni thread resta a un agente solo).
GROUP_CHATS=
# Free SFB listings require badge verify before status=completed. Default on.
FEATURE_SFB_BADGE=
# Require reachable public URL (HTTP 200, soft-ok for app-hosted paths) before keeping published. Default on.
FEATURE_PUBLISH_VERIFY=

# SEO multi-step agent (DataForSEO tool loop). Default on; set false to use the legacy one-shot plan.
# When on, GSC is read via the read_gsc_summary tool (see FEATURE_GSC_IN_AGENT).
SEO_AGENT_ENABLED=

# Google Search Console OAuth (Web application client).
# Authorized redirect URI (ONE, all brands): {PUBLIC_APP_URL}/auth/gsc/callback
# Authorized JavaScript origins: {PUBLIC_APP_URL} (and http://localhost:5173 for local)
# Scopes: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=

# Composio — connectors (Drive, Notion, GitHub, Gmail → brand corpus; any other toolkit as
# agent tools). One project API key; Composio holds the OAuth tokens and we never read them.
#   1. Create a project at https://platform.composio.dev and copy its API key here.
#   2. Nothing else to register: 120+ toolkits ship with a Composio-managed OAuth app, and the
#      first connect for a toolkit creates the auth config automatically.
#   3. Want your own OAuth app for a toolkit (your name on the consent screen, your scopes,
#      your quota)? Create a custom auth config for it in the Composio dashboard — the code
#      picks a custom config over the managed one without any change here.
#   4. In Settings → Connectors, mark each toolkit slug as App or MCP and Visible.
#      Brands only see Visible ones. Slugs are upper-case: GOOGLEDRIVE, NOTION, GITHUB, GMAIL,
#      SUPABASE, CANVA, HUBSPOT, …
#
# Scope notes:
#   GOOGLEDRIVE  Composio's managed app asks for Drive scopes; a custom auth config can narrow
#                them (e.g. drive.file only). Existing connections must reconnect after a change.
#   GITHUB       Composio's GitHub toolkit is OAuth — no GitHub App registration needed.
COMPOSIO_API_KEY=
# Signs the trigger events Composio posts to /api/v1/composio/webhook. Create the webhook
# subscription in the Composio dashboard, point it at that URL, and copy its secret here.
# Without it the ingress answers 503 and no brand webhook is ever delivered.
COMPOSIO_WEBHOOK_SECRET=

# Google Picker (Drive file grant UI). Unused with Composio-brokered connections:
# the picker needs a raw OAuth token in the browser, which Composio does not hand out.
# Drive scope is picked from the server-side folder list instead.
# Enable the Google Picker API. API key = browser key (HTTP referrers = PUBLIC_APP_URL).
# APP_ID = Cloud project NUMBER (not the project id string). Required for drive.file.
# Authorized JavaScript origins on the OAuth client: PUBLIC_APP_URL (+ http://localhost:5173).
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# SubmitForBacklinks Agent API — owner-reviewed directory listings (not paid link buys).
# Docs: https://submitforbacklinks.com/docs/api
SUBMITFORBACKLINKS_API_KEY=

# Optional Vercel deploy safety net if a serverless function still exceeds 250MB unzipped
# (Fluid Compute large-functions beta). Prefer keeping bundles small; ffmpeg is resolved at
# runtime and no longer packed via the ffmpeg-static import.
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
#   update public.app_flags set enabled=false where key='waitlist';  -- open to all

# Radar engage (Reddit read-only, official API): create a "script" app at reddit.com/prefs/apps.
# Without these, subreddit sources are skipped (news sources keep working).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# …or the simpler personal-feed auth: your RSS token + username from reddit.com/prefs/feeds
REDDIT_FEED_TOKEN=
REDDIT_FEED_USER=

# ── The public wall: /trending and /design (migration 0199) ─────────────────────────────────────
# Both pages read the market bank; nothing here is required for them to work, and every value has a
# defensible default in code. Set them when the wall's character needs changing without a deploy.
#
# The bar for the design wall, 0–100. Default 68, calibrated against the judge's actual output on
# thirty real posts (nothing scored above 72 — the rubric itself tells the model that competent work
# is 55–70). Raise it as the bank deepens: the number of cards above any bar grows with the corpus.
# WALL_MIN_DESIGN_SCORE=68
#
# The curated accounts the design sweep reads, as `platform:handle` pairs. This list IS the wall's
# taste; the default is in `design-discovery.ts` and is stated in code on purpose. Only platforms in
# scrapecreators' FETCHERS map work here (instagram, tiktok, x, threads, facebook, youtube).
# WALL_DESIGN_ACCOUNTS=instagram:figma,instagram:pentagramdesign,x:vercel
#
# The design hashtags, the other half of the corpus. Unbounded reach, terrible precision — acceptable
# only because this source feeds a judge whose job is to say no. Measured by what clears the bar,
# never by what it returns.
# WALL_DESIGN_TOPICS=design,graphicdesign,uidesign,typography

# ── Internal access lists (comma-separated emails) ───────────────────────────────────────────
# Team members who get internal-only affordances (debug panels, unmetered previews). Empty = nobody.
INTERNAL_EMAILS=
# Users who can preview the Ads feature before FEATURE_ADS is globally on.
ADS_PREVIEW_EMAILS=
# Users exempt from brand/slot limits (see src/lib/server/brand-limits.ts).
UNLIMITED_SLOT_EMAILS=

# ── Alternate/optional model providers — every one below is optional; unset = that path is
# skipped or falls back to Gemini/kie. Grouped by provider, not by feature. ──────────────────────
# Xiaomi MiMo (legacy chat/text fallback provider).
XIAOMI_MIMO_API_KEY=
# XIAOMI_MODEL=mimo-v2.5-pro
# XIAOMI_VISION_MODEL=mimo-v2.5
# DeepSeek's own web-search grounding (default on when DEEPSEEK_API_KEY is set; 'off' disables it).
# DEEPSEEK_WEB_SEARCH=off
# DEEPSEEK_WEB_SEARCH_MAX_USES=5
# Search fallbacks used by research/GEO/radar tooling, tried in the order each caller defines —
# none required, each just narrows what research can cite.
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
BING_SEARCH_API_KEY=
# Google Generative AI key alias — only read when GEMINI_API_KEY is unset.
GOOGLE_API_KEY=
# Unsplash stock photo fallback for research/blog images.
UNSPLASH_ACCESS_KEY=
# DataForSEO (rank tracking, keyword volume) — SEO agent degrades to estimates without it.
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
# Meta Conversions API server-side token (ads attribution). Optional.
META_CAPI_TOKEN=

# ── Model id overrides — every default already matches production; only set to pin a different
# model without a deploy. ─────────────────────────────────────────────────────────────────────
# MOTION_VIDEO_MODEL=            # default: current Gemini Flash text model
# STUDIO_CHAT_MODEL=             # Studio AI note-taking chat, default: current Gemini Flash
# GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# KIE_TTS_MODEL=google/gemini-3-1-flash-tts
# IMAGE_MODEL_NO_REF=            # image model when there is no reference image to anchor to
# KIE_VIDEO_UPSCALE_RESOLUTION=720p
# GROK_CONTEXT_WINDOW=           # 500000 for grok-4-6*, 256000 for other grok models
# Deprecated: still read as a stale-value warning, no longer changes behaviour.
# GEMINI_JUDGE_THINKING_BUDGET=
# PREPUBLISH_THINKING_BUDGET=

# ── Content credentials (C2PA signing of generated images/video) — optional; unsigned output
# ships fine without this. ────────────────────────────────────────────────────────────────────
# C2PA_SIGNING=on
C2PA_CERT=
C2PA_KEY=

# ── ffmpeg binary (video render) — optional overrides; a working default is resolved at runtime.
# FFMPEG_BIN=                    # path to an already-installed ffmpeg, skips the download
# FFMPEG_BINARIES_URL=
# FFMPEG_BINARY_RELEASE=b6.1.1

# ── GitHub device-flow login for the in-chat sandbox shell (optional; sandbox git push only).
GITHUB_DEVICE_CLIENT_ID=

# ── Vercel Sandbox (in-chat shell + motion-video render) — NOT available self-hosted without a
# Vercel account; see docs/SELF_HOSTING.md. SANDBOX_DISABLED=1 turns the feature off cleanly.
# SANDBOX_DISABLED=1
SANDBOX_VERCEL_TOKEN=
# SANDBOX_ALLOWED_DOMAINS=       # comma-separated egress allowlist for sandboxed shell commands
# SANDBOX_GENERATION=g5
# SANDBOX_VCPUS=2
# SANDBOX_IMAGE=                 # base sandbox image; SANDBOX_BROWSER_IMAGE used when a browser is needed
# SANDBOX_BROWSER_IMAGE=vercel/sandbox/ubuntu
# SANDBOX_PLAYWRIGHT_VERSION=1.60.0
# SANDBOX_BROWSERS_PATH=.anomalia/browsers
# SANDBOX_USD_PER_SECOND=        # sandbox cost passthrough → credits; unset disables the charge
# SANDBOX_CREDIT_MARKUP=

# ── Background worker (src/worker — optional long-running process; cron ticks work without it).
# WORKER_BATCH=3
# WORKER_IDLE_POLL_MS=2000
# WORKER_REAP_EVERY_MS=60000

# ── Market/radar tick tuning — optional, sane defaults ship in code.
# MARKET_CATEGORIES_PER_TICK=2
# MARKET_DISCOVERY_CATEGORIES=
# MARKET_HASHTAGS_PER_TICK=6
# MARKET_TREND_HASHTAGS=

# ── Misc ──────────────────────────────────────────────────────────────────────────────────────
# GEO citation audit: how many samples per probe, 1-5. Default 3.
# GEO_CITATION_SAMPLES=3
# Carousel batch limits (content-preview generation).
# CAROUSEL_MAX_PER_BATCH=1
# CAROUSEL_MAX_SLIDES=6
# Chat turn token budget override (src/lib/server/chat/turn-limits.ts). Default is model-derived.
# CHAT_TURN_TOKEN_BUDGET=
# context7 MCP tool key used by the in-chat sandbox's docs lookup. Optional.
CONTEXT7_API_KEY=
# Marketing "book a call" link used by the lifecycle drip email. Defaults to Anomalia's Calendly.
# CALENDLY_URL=
# Domain used to build sender addresses when EMAIL_FROM is unset. Defaults to "anomalia.so".
# EMAIL_DOMAIN=
# Feature flag toggles — same on/off convention as the FEATURE_* flags above.
# ANALYTICS_REVIEW_AGENT_ENABLED=true
# VIDEO_REVIEW_AGENT_ENABLED=true
# AUTO_VIDEO_REVIEW=on
# CHAT_REVIEW_VIDEO=on
# COPY_PANEL_ENABLED=true
# AGENT_KIT=off                  # experimental agent-kit chat bridge, default off
# Skill packs for the agent harness (src/lib/server/harness-skills). HARNESS_SKILLS picks which
# ones a chat turn may see (comma-separated names, or *); empty = none, the default.
# HARNESS_SKILLS_EXTRA_DIRS adds folders of skills outside the repo (colon/semicolon separated,
# absolute paths), e.g. the Superpowers plugin pack:
# HARNESS_SKILLS_EXTRA_DIRS=~/.claude/plugins/superpowers/skills
# Override the release tag shown to clients for cache-busting (default: package.json version + git sha).
# APP_RELEASE=
# Billing provider (src/lib/server/billing): "open" removes ALL credit/quota gating (self-hosted
# fork default once the anomalia provider is extracted). Unset = anomalia (today's product).
# BILLING_PROVIDER=open

# NOT listed above: NODE_ENV, PORT, ORIGIN, VERCEL_GIT_COMMIT_SHA, VERCEL_OIDC_TOKEN,
# VERCEL_PROJECT_ID, VERCEL_TEAM_ID — these are injected by the runtime/platform (Node, Vercel),
# not something you set by hand in .env.

# Controllore shadow della chat: vuoto = spento. Valori: shadow (giudica, non blocca).
CHAT_CONTROLLER=shadow

# Immagine con il desktop XFCE + VNC + Chromium (sandbox-desktop/): la usa SOLO la lane del
# computer. Senza, il desktop si installa a runtime (lento). Si ricostruisce con
# `node sandbox-desktop/build.mjs`.
SANDBOX_DESKTOP_IMAGE=desktop:latest

# Desktop grafico della VM (anteprima, controllo utente, tool observe/act dell'agente).
# RIMOSSO dal prodotto di default: l'agente usa solo browse. Metti 1 per rimetterlo in piedi.
AGENT_DESKTOP_ENABLED=
