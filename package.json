{
  "name": "anomalia",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:stable": "NO_HMR=1 vite dev",
    "dev:vercel": "vercel dev --listen 5173",
    "build": "node scripts/typecheck-runtime.mjs && vite build",
    "build:node": "NODE_OPTIONS=--max-old-space-size=8192 DEPLOY_TARGET=node npm run build",
    "start": "node --env-file-if-exists=.env build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:runtime": "node scripts/typecheck-runtime.mjs",
    "release": "node scripts/release.mjs",
    "test:unit": "vitest run",
    "check:motion-chain": "vitest run src/lib/motion-video/chain.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "bake:style-reels": "vite-node --config scripts/vite-node.config.ts scripts/bake-style-reels.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "bake:motion-library": "vite-node --config scripts/vite-node.config.ts scripts/bake-motion-library.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "tool-e2e": "vite-node --config scripts/vite-node.config.ts scripts/tool-e2e/run.ts",
    "oss:export": "node scripts/export-oss.mjs",
    "test:durability": "npm run eval:durability"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.21.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^5.5.0",
    "@sveltejs/kit": "^2.31.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.12",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/harness": "^1.0.86",
    "@ai-sdk/harness-claude-code": "^1.0.89",
    "@ai-sdk/harness-pi": "^1.0.88",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/sandbox-just-bash": "^1.0.86",
    "@ai-sdk/sandbox-vercel": "^1.0.86",
    "@ai-sdk/xai": "^4.0.44",
    "@google/genai": "^2.7.0",
    "@microsoft/clarity": "^1.0.2",
    "@remotion/google-fonts": "4.0.506",
    "@remotion/paths": "4.0.506",
    "@remotion/player": "4.0.506",
    "@remotion/shapes": "4.0.506",
    "@remotion/transitions": "4.0.506",
    "@remotion/web-renderer": "4.0.506",
    "@resvg/resvg-js": "^2.6.2",
    "@seline-analytics/node": "^1.0.1",
    "@sentry/sveltekit": "^10",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^3.0.1",
    "ai": "^7.0.77",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "lucide-static": "^1.28.0",
    "marked": "^18.0.5",
    "markitdown-ts": "^0.0.10",
    "node-html-parser": "^9.0.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.506",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.22.0",
    "sucrase": "^3.35.1",
    "svelte-i18n": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.6.2",
    "unzipper": "^0.12.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
