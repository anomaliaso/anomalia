#!/bin/sh
# ACCENDE IL DESKTOP, E LO RIACCENDE.
#
# Non è un entrypoint: la sandbox esegue comandi, non avvia servizi. Questo script viene invocato
# a ogni apertura (`ensureGraphicalMode`) ed è IDEMPOTENTE — ogni pezzo si lancia solo se il suo
# processo non c'è già. Serve perché lo stop della VM conserva il disco e uccide i processi:
# al risveglio il desktop è installato ma spento, e nessuno lo rimette in piedi da solo.
#
# Ogni pezzo è un processo suo, avviato con setsid: `xfce4-session` e `startxfce4` muoiono insieme
# al comando che li ha lanciati (visto dal vivo il 26/8 — sopravviveva solo xfwm4), mentre i
# singoli componenti reggono.
set -e

DISPLAY_NUM="${ANOMALIA_DISPLAY:-:1}"
SCREEN="${ANOMALIA_SCREEN:-1440x900x24}"
BUS_SOCKET=/tmp/anomalia-dbus
VNC_PORT="${ANOMALIA_VNC_PORT:-5900}"
WEB_PORT="${ANOMALIA_WEB_PORT:-6080}"
PASSWORD_FILE="${ANOMALIA_VNC_PASSWORD_FILE:-/vercel/.anomalia-desktop/vncpass}"

export DISPLAY="$DISPLAY_NUM"
export XDG_RUNTIME_DIR=/tmp/xdg
export DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS_SOCKET"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

alive() { pgrep -f "$1" >/dev/null 2>&1; }
spawn() { setsid "$@" >/dev/null 2>&1 & }

alive "[X]vfb $DISPLAY_NUM" || spawn Xvfb "$DISPLAY_NUM" -screen 0 "$SCREEN"

# Il socket di X compare PRIMA che il server accetti connessioni, e un window manager lanciato in
# quel buco muore con «Failed to open the display». Si aspetta una risposta, non un file.
i=0
while ! xdotool getdisplaygeometry >/dev/null 2>&1 && [ $i -lt 40 ]; do
  sleep 0.25
  i=$((i + 1))
done

# Il bus di sessione con un indirizzo FISSO: il pannello e la scrivania si parlano solo se lo
# trovano allo stesso posto a ogni riavvio, e `dbus-launch` per processo ne creerebbe uno a testa.
if ! alive "dbus-daemon --session --address=unix:path=$BUS_SOCKET"; then
  rm -f "$BUS_SOCKET"
  spawn dbus-daemon --session --address="unix:path=$BUS_SOCKET" --nofork
  i=0
  while [ ! -S "$BUS_SOCKET" ] && [ $i -lt 20 ]; do
    sleep 0.25
    i=$((i + 1))
  done
fi

# xfsettingsd prima del pannello: è lui a servire tema, font e cursori via xfconf, e senza di lui
# i wrapper dei plugin del pannello abortiscono.
alive "[x]fsettingsd" || spawn xfsettingsd --sm-client-disable
alive "[x]fwm4" || spawn xfwm4 --sm-client-disable
alive "[x]fce4-panel" || spawn xfce4-panel --sm-client-disable
alive "[x]fdesktop" || spawn xfdesktop --sm-client-disable

if [ -f "$PASSWORD_FILE" ]; then
  # `-localhost`: la porta pubblica è quella di websockify, mai quella di VNC.
  alive "[x]11vnc" || spawn x11vnc -display "$DISPLAY_NUM" -rfbauth "$PASSWORD_FILE" \
    -rfbport "$VNC_PORT" -localhost -forever -shared -noxdamage
  alive "[w]ebsockify" || spawn websockify --web=/usr/share/novnc "$WEB_PORT" "localhost:$VNC_PORT"
fi

sleep 2
printf 'display=%s wm=%s panel=%s desktop=%s vnc=%s web=%s\n' \
  "$DISPLAY_NUM" \
  "$(alive '[x]fwm4' && echo up || echo down)" \
  "$(alive '[x]fce4-panel' && echo up || echo down)" \
  "$(alive '[x]fdesktop' && echo up || echo down)" \
  "$(alive '[x]11vnc' && echo up || echo down)" \
  "$(alive '[w]ebsockify' && echo up || echo down)"
